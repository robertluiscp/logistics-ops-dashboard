# Copie para .env e ajuste. NUNCA commite o .env.

# --- Fonte de dados ---------------------------------------------------------
# "demo" gera uma operacao sintetica e deterministica (nenhuma rede necessaria).
DATA_SOURCE=demo
DEMO_SEED=42

# --- PostgreSQL -------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=logistics_ops
PGUSER=postgres
PGPASSWORD=change-me

# --- Regras de negocio ------------------------------------------------------
# Horas entre o deslacre do veiculo e a troca de responsabilidade do pacote.
PRAZO_LIMITE_HORAS=6

# --- API --------------------------------------------------------------------
API_PORT=3001
# Segredo de assinatura das sessoes (JWT). Gere um valor longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# true (padrao) exige HTTPS. Use false so' para testar em http://localhost.
COOKIE_SECURE=false

# --- Alerta proativo (opcional; webhook Feishu/Lark) ------------------------
# Vazio = alerta desligado, sem erro.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
PAINEL_URL=http://localhost:3001
